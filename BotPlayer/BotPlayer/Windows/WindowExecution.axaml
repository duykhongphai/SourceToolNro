<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="550"
        x:Class="BotPlayer.Windows.WindowExecution"
        Width="400" Height="550"
        Title="Bot Player"
        Background="#f5f6fa"
        ExtendClientAreaChromeHints="NoChrome"
        Icon="/Assets/Icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4267B2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#365899" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#808080" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#dc3545" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #15000000" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="Foreground" Value="#4267B2" />
        </Style>
        <Style Selector="TextBlock.notification">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="#F8F9FA" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#4267B2" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="#A4A4A4" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="#dc3545" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <StreamGeometry x:Key="network_check_regular">M10.0492532,15.4208574 L16.3060077,6.94493547 C16.5131405,6.66433611 16.8962754,6.58091825 17.2013158,6.75000494 C17.4758699,6.90219275 17.61052,7.21639422 17.5413028,7.51420559 L17.510592,7.61262428 L13.6405266,17.4116224 C13.2205308,18.475051 12.0179777,18.9966563 10.9545491,18.5766605 C10.8710782,18.543694 10.7898393,18.5053348 10.7113465,18.4618255 C9.71108052,17.9073691 9.34968053,16.6470175 9.904137,15.6467516 L9.97303013,15.5314501 L9.97303013,15.5314501 L10.0492532,15.4208574 L16.3060077,6.94493547 L10.0492532,15.4208574 Z M13.850015,12.7977214 L11.2560655,16.3117019 L11.2160666,16.373966 L11.2160666,16.373966 C11.0632395,16.6496733 11.1628536,16.9970689 11.4385609,17.149896 L11.5055502,17.1815268 L11.5055502,17.1815268 C11.769176,17.2856445 12.0638421,17.1796801 12.2044743,16.9439092 L12.2453929,16.8606213 L13.850015,12.7977214 Z M12.1004127,10.8717741 L10.873882,12.5318432 C10.5697503,12.6313365 10.2749505,12.7767433 9.99925561,12.969787 C9.13944179,13.5718351 8.62724387,14.5267512 8.583371,15.5561358 C8.56573302,15.9699737 8.21595275,16.2911572 7.80211489,16.2735192 C7.38827702,16.2558812 7.06709355,15.9061009 7.08473152,15.4922631 C7.14827801,14.0012785 7.89249747,12.613793 9.13889095,11.7410589 C10.0394957,11.1104486 11.0806146,10.830199 12.1004127,10.8717741 Z M16.267545,13.6232396 C16.5467328,14.2092787 16.7031128,14.8425922 16.7301437,15.4894392 C16.747438,15.9032915 16.4259642,16.252805 16.0121119,16.2700994 C15.7393053,16.2814996 15.4944559,16.1456953 15.3542942,15.9332613 L16.267545,13.6232396 Z M14.0336291,8.25379828 L13.0651378,9.56458905 C11.4714513,9.26372423 9.76255402,9.5807183 8.32907663,10.58445 C7.14097832,11.4163654 6.30096715,12.6095106 5.91040208,13.9746317 C5.79646581,14.3728671 5.38126867,14.603337 4.98303331,14.4894007 C4.58479795,14.3754645 4.35432801,13.9602673 4.46826428,13.562032 C4.95260309,11.8691484 5.99626359,10.3867414 7.46871197,9.35572191 C9.45577881,7.96436273 11.8694868,7.63679936 14.0336291,8.25379828 Z M17.5432004,10.3917992 C17.7948899,10.6583848 18.0299155,10.9469179 18.2464234,11.2561232 C18.7404759,11.9617033 19.1085593,12.7332874 19.3432759,13.5448963 C19.4583505,13.9428042 19.2290689,14.3586587 18.831161,14.4737333 C18.433253,14.588808 18.0173985,14.3595263 17.9023239,13.9616184 C17.7133095,13.3080398 17.4167671,12.6864215 17.0176953,12.1164879 L16.9164362,11.9787648 L17.5432004,10.3917992 L17.5432004,10.3917992 Z M15.9809484,5.85271523 L15.8929,5.9067631 C15.7705043,5.98872343 15.657207,6.08714008 15.5565187,6.20124873 L15.4601633,6.32055973 L14.919203,7.05349635 C12.2377261,6.12139933 9.16202923,6.44647249 6.65889532,8.19918572 C5.15624513,9.25135271 4.03081393,10.6986791 3.38083698,12.3709425 C3.23077656,12.7570186 2.79615204,12.9483471 2.41007596,12.7982867 C2.02399987,12.6482263 1.83267137,12.2136018 1.98273179,11.8275257 C2.73939974,9.88076718 4.05088387,8.19417311 5.79853067,6.97045765 C8.8904309,4.8054858 12.7328827,4.5119546 15.9809484,5.85271523 Z M18.6097159,7.41452553 C19.364635,8.02588428 20.0472146,8.75117955 20.6317275,9.58595046 C21.1228605,10.287361 21.5238375,11.0364567 21.8306196,11.8204741 C21.9815557,12.2062087 21.7912138,12.6412663 21.4054792,12.7922023 C21.0197446,12.9431383 20.5846871,12.7527965 20.4337511,12.3670619 C20.1702797,11.6937301 19.8256987,11.0499923 19.4029994,10.4463151 C19.0173167,9.89550306 18.5819382,9.40016829 18.1071651,8.96212719 L18.4883177,7.99876394 L18.4883177,7.99876394 C18.5638355,7.8075531 18.6033536,7.61016309 18.6097159,7.41452553 Z</StreamGeometry>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#4267B2" Padding="10,10" BoxShadow="0 1 8 0 #20000000"
                PointerPressed="Panel_PointerPressed">
            <Panel>
                <TextBlock Text="Bot Player" FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" />
                <Border Name="CloseButton"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        Width="20" Height="20"
                        CornerRadius="10"
                        PointerPressed="CloseButton_Click">
                    <TextBlock Text="×"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-3,0,0" />
                </Border>
            </Panel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,20,20,80">
            <StackPanel Spacing="20">
                <Border Classes="card" Margin="0,12,0,20">
                    <StackPanel>
                        <TextBlock Text="Máy chủ" Classes="header" />
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Địa chỉ IP:" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Name="IpAddressTextBox" Watermark="Nhập địa chỉ IP"
                                     Margin="0,5" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cổng:" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Name="PortTextBox" Watermark="Nhập cổng" Margin="0,5" />
                            <Button Name="CheckServer" Click="CheckServer_OnClick" Classes="primary" Width="160"
                                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource network_check_regular}" Width="16" Height="16"
                                              Foreground="White" />
                                    <TextBlock Text="Kiểm tra kết nối" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Tài khoản" Classes="header" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10">
                            <Button Name="ImportButton" Click="ImportButton_Click" Classes="primary" Width="160"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7z" Width="16" Height="16"
                                              Foreground="White" />
                                    <TextBlock Text="Nhập file" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Name="NumAccountText"
                                       Text="ℹ️ Số lượng: "
                                       Classes="notification" VerticalAlignment="Center" Foreground="#dc3545" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10">
                            <Button Name="LoginButton" Classes="primary" Click="LoginButton_Click" Width="160">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5z" Width="16"
                                              Height="16" Foreground="White" />
                                    <TextBlock Text="Đăng nhập" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Name="LogoutButton" Classes="danger" Click="LogoutButton_Click" Width="160"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5z"
                                              Width="16" Height="16" Foreground="White" />
                                    <TextBlock Text="Đăng xuất" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="0,12,0,20">
                    <StackPanel>
                        <TextBlock Text="Cài đặt tự động" Classes="header" />
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                            <CheckBox Name="MonsterCheckBox" IsCheckedChanged="MonsterCheckBox_OnIsCheckedChanged"
                                      Grid.Row="0" Grid.Column="0" Content="Đánh quái"
                                      IsChecked="False" />
                            <CheckBox Name="MapCheckBox" IsCheckedChanged="MapCheckBox_OnIsCheckedChanged" Grid.Row="0"
                                      Grid.Column="1" Content="Chuyển map"
                                      IsChecked="False" />
                            <CheckBox Name="ChatCheckBox" IsCheckedChanged="ChatCheckBox_OnIsCheckedChanged"
                                      Grid.Row="1" Grid.Column="0" Content="Chat" IsChecked="False" />
                            <CheckBox Name="WorldChatCheckBox" IsCheckedChanged="WorldChatCheckBox_OnIsCheckedChanged"
                                      Grid.Row="1" Grid.Column="1" Content="Chat thế giới"
                                      IsChecked="False" />
                            <CheckBox Name="PvpCheckBox" IsCheckedChanged="PvpCheckBox_OnIsCheckedChanged" Grid.Row="2"
                                      Grid.Column="0" Content="Đánh nhau"
                                      IsChecked="False" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Margin="0,12,0,100" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#f0f6ff" BorderBrush="#0000001a"
                BorderThickness="0,1,0,0" Padding="8,5"
                VerticalAlignment="Bottom" Name="NotificationBorder" Height="35">
            <TextBlock Name="NotificationText"
                       Text="Đã đăng xuất. Vui lòng đăng nhập lại để tiếp tục."
                       Classes="notification" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>