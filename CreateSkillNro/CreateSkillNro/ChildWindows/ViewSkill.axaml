<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:options="clr-namespace:CreateSkillNro.Options"
        mc:Ignorable="d" d:DesignWidth="1085" d:DesignHeight="610"
        x:Class="CreateSkillNro.ChildWindows.ViewSkill"
        Title="ViewSkill"
        Width="1085" Height="610"
        Background="{DynamicResource WindowBackgroundGradient}"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Icon="/Assets/Icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Window.Styles>
        <Style Selector="Border.modern-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E8ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #0F000000, 0 1 4 0 #0A000000" />
        </Style>
        <Style Selector="ComboBox.modern-combo">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DDE4EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <Panel Grid.Row="0" KeyDown="InputElement_OnKeyDown" Focusable="True" IsTabStop="True" Name="PanelTotal">
            <options:PanelViewSkill x:Name="MainSkillPanel" Margin="10" />
        </Panel>

        <Border Grid.Row="1"
                x:Name="BuildProgressPanel"
                Background="{DynamicResource ActionPanelGradient}"
                BorderBrush="#dee2e6"
                BorderThickness="0,1,0,0"
                Height="80"
                IsVisible="False"
                Margin="10,0,10,10"
                CornerRadius="0,0,12,12">
            <Grid RowDefinitions="Auto,*" Margin="20">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="BuildProgressText"
                                   Text="Building images..."
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="BuildProgressDetail"
                                   Text="Processing x1 scale..."
                                   Foreground="#cbd5e1"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="BuildProgressCount"
                                   Text="0 / 0"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="BuildProgressPercent"
                                   Text="0%"
                                   Foreground="#10b981"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <Button x:Name="BuildCancelButton"
                            Grid.Column="2"
                            Classes="primary"
                            Content="Cancel"
                            Width="70"
                            Height="32"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Click="BuildCancelButton_OnClick" />
                </Grid>

                <ProgressBar x:Name="BuildProgressBar"
                             Grid.Row="1"
                             Value="0"
                             Minimum="0"
                             Maximum="100"
                             Height="10"
                             VerticalAlignment="Center"
                             Background="#4a5568"
                             Foreground="#10b981"
                             CornerRadius="5" />
            </Grid>
        </Border>
    </Grid>
</Window>