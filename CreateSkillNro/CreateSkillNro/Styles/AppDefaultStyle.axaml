<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Background="AliceBlue" Width="300" Height="100" />
    </Design.PreviewWith>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource SegoeUISemibold}" />
    </Style>
    <Style Selector="Button.purple">
        <Setter Property="Background" Value="{DynamicResource PurpleGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.purple:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PurpleGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.purple:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PurpleGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.aqua">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.dark">
        <Setter Property="Background" Value="{DynamicResource DarkGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.aqua:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.aqua:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DarkGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.dark:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DarkGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Width" Value="110" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonGradient}" />
        <Setter Property="Foreground" Value="#4a5568" />
        <Setter Property="BorderBrush" Value="#e2e8f0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Width" Value="110" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverGradient}" />
        <Setter Property="BorderBrush" Value="#9ae6b4" />
        <Setter Property="Foreground" Value="#22543d" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonPressedGradient}" />
        <Setter Property="BorderBrush" Value="#68d391" />
        <Setter Property="Foreground" Value="#22543d" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.image:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ImageButtonHoverGradient}" />
        <Setter Property="Foreground" Value="#4a5568" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.image:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ImageButtonHoverGradient}" />
        <Setter Property="Foreground" Value="#4a5568" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonGradient}" />
        <Setter Property="BorderBrush" Value="#e2e8f0" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#4a5568" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="4,0,0,0" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Margin" Value="0,6,0,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#4a5568" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.sidebarIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.sidebarIcon:pointerover">
        <Setter Property="Background" Value="#20ffffff" />
        <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>

    <Style Selector="Button.sidebarIcon:pressed">
        <Setter Property="Background" Value="#30ffffff" />
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <Style Selector="Button.tertiary">
        <Setter Property="Background" Value="{DynamicResource TertiaryButtonGradient}" />
        <Setter Property="Foreground" Value="#553c9a" />
        <Setter Property="BorderBrush" Value="#d6bcfa" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tertiary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TertiaryButtonHoverGradient}" />
        <Setter Property="BorderBrush" Value="#b794f6" />
        <Setter Property="Foreground" Value="#44337a" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tertiary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TertiaryButtonPressedGradient}" />
        <Setter Property="BorderBrush" Value="#9f7aea" />
        <Setter Property="Foreground" Value="#44337a" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
</Styles>