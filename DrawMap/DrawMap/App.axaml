<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DrawMap.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/AppDefaultStyle.axaml" />
    </Application.Styles>
    <Application.Resources>
        <LinearGradientBrush x:Key="AquaGradientBrush" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="Aqua" />
            <GradientStop Offset="1" Color="DodgerBlue" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AquaGradientBrushHover" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="#00B8B8" />
            <GradientStop Offset="1" Color="#0078C8" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AquaGradientBrushPressed" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="#009696" />
            <GradientStop Offset="1" Color="#005A96" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGradientBrush" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="#448888" />
            <GradientStop Offset="1" Color="#446A88" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGradientBrushHover" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="#377777" />
            <GradientStop Offset="1" Color="#375A77" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGradientBrushPressed" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="#2A6666" />
            <GradientStop Offset="1" Color="#2A4A66" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkGradientBrush" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="Black" />
            <GradientStop Offset="1" Color="#303957" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkGradientBrushHover" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#202020" />
            <GradientStop Offset="1" Color="#404B6A" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkGradientBrushPressed" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#101010" />
            <GradientStop Offset="1" Color="#25304F" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleGradientBrush" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="#8B7FC7" />
            <GradientStop Offset="1" Color="#A294D9" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradientBrushHover" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#9A8FD1" />
            <GradientStop Offset="1" Color="#B3A6E3" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradientBrushPressed" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#7C6FBD" />
            <GradientStop Offset="1" Color="#9187CF" />
        </LinearGradientBrush>
        <FontFamily x:Key="SegoeUIBold">avares://DrawMap/Assets/Fonts/SegoeUIBold.ttf#Segoe UI</FontFamily>
        <FontFamily x:Key="SegoeUISemibold">avares://DrawMap/Assets/Fonts/SegoeUISemibold.ttf#Segoe UI</FontFamily>

    </Application.Resources>
</Application>