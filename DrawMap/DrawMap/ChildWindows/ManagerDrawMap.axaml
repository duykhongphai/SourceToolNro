<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="420"
        x:Class="DrawMap.ChildWindows.ManagerDrawMap"
        Title="ManagerDrawMap"
        Width="320" Height="420"
        ExtendClientAreaChromeHints="NoChrome"
        Icon="/Assets/Icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        CanResize="False"
        Background="#FFFAFAFA"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF374151" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                Background="White"
                                BorderBrush="#FFD1D5DB"
                                BorderThickness="1.5"
                                CornerRadius="3"
                                Margin="0,0,6,0">
                            <Path Name="CheckMark"
                                  Width="8" Height="6"
                                  Data="M0,3 L2,5 L8,0"
                                  Stroke="White"
                                  StrokeThickness="1.5"
                                  IsVisible="False" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox:checked /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Border">
            <Setter Property="Background" Value="#FF3B82F6" />
            <Setter Property="BorderBrush" Value="#FF3B82F6" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="Foreground" Value="#FF475569" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFE2E8F0" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#FFE2E8F0" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFCBD5E1" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#FFCBD5E1" />
            <Setter Property="BorderBrush" Value="#FF94A3B8" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="BorderBrush" Value="#FFD1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#FF3B82F6" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#FFE5E7EB" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF9CA3AF" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Styles>

    <ScrollViewer Background="Transparent">
        <StackPanel Orientation="Vertical" Margin="8">
            <Border Background="#FF4F46E5"
                    CornerRadius="8,8,0,0"
                    Height="36"
                    Margin="6,0,6,0"
                    PointerPressed="InputElement_OnPointerPressed"
                    Cursor="Hand">
                <Grid>
                    <TextBlock Text="DrawMap Manager"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Ellipse Width="4" Height="4" Fill="White" Opacity="0.7" Margin="0,0,2,0" />
                        <Ellipse Width="4" Height="4" Fill="White" Opacity="0.7" Margin="0,0,2,0" />
                        <Ellipse Width="4" Height="4" Fill="White" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-header" Text="Display Settings" />
                    <Grid ColumnDefinitions="Auto,Auto,*,8,Auto,*" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="Size:" FontSize="11" Foreground="#FF6B7280"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Name="WidthTextBox" Text="1024" Width="50"
                                 KeyDown="TextBoxNumeric_OnKeyDown" TextChanged="WidthTextBox_OnTextChanged" />
                        <TextBlock Grid.Column="2" Text="×" FontSize="11" Foreground="#FF6B7280"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="4" Name="HeightTextBox" Text="768" Width="50"
                                 KeyDown="TextBoxNumeric_OnKeyDown" TextChanged="HeightTextBox_OnTextChanged" />
                    </Grid>

                    <UniformGrid Columns="2" Margin="0">
                        <CheckBox Name="ViewGridCheck" Content="Grid" IsChecked="True"
                                  IsCheckedChanged="ViewGridCheck_OnIsCheckedChanged" />
                        <CheckBox Name="TitleTypeCheck" Content="Title Type"
                                  IsCheckedChanged="TitleTypeCheck_OnIsCheckedChanged" />
                        <CheckBox Name="ViewBackgroundCheck" Content="Background"
                                  IsCheckedChanged="ViewBackgroundCheck_OnIsCheckedChanged" />
                        <CheckBox Name="ViewItemBackgroundCheck" Content="Item Background"
                                  IsCheckedChanged="ViewItemBackgroundCheck_OnIsCheckedChanged" />
                        <CheckBox Name="ViewEffectCheck" Content="Effects"
                                  IsCheckedChanged="ViewEffectCheck_OnIsCheckedChanged" />
                        <CheckBox Name="ViewActorCheck" Content="Actors"
                                  IsCheckedChanged="ViewActorCheck_OnIsCheckedChanged" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-header" Text="Editor Mode" />
                    <UniformGrid Columns="2" Margin="0">
                        <RadioButton Name="TileMapRadio" Content="Tile Map" GroupName="EditorMode" IsChecked="True"
                                     IsCheckedChanged="TileMapRadio_OnIsCheckedChanged" />
                        <RadioButton Name="ItemBackgroundRadio" Content="Item Background" GroupName="EditorMode"
                                     IsCheckedChanged="ItemBackgroundRadio_OnIsCheckedChanged" />
                        <RadioButton Name="EffectRadio" Content="Effect" GroupName="EditorMode"
                                     IsCheckedChanged="EffectRadio_OnIsCheckedChanged" />
                        <RadioButton Name="MonsterRadio" Content="Monster" GroupName="EditorMode"
                                     IsCheckedChanged="MonsterRadio_OnIsCheckedChanged" />
                        <RadioButton Name="NpcRadio" Content="NPC" GroupName="EditorMode"
                                     IsCheckedChanged="NpcRadio_OnIsCheckedChanged" />
                        <RadioButton Name="WaypointRadio" Content="Waypoint" GroupName="EditorMode"
                                     IsCheckedChanged="WaypointRadio_OnIsCheckedChanged" />
                    </UniformGrid>
                    <ComboBox Name="LayerEffectFieldComboBox"
                              Height="36"
                              Margin="0,10,0,0"
                              IsVisible="{Binding #EffectRadio.IsChecked}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Layer 1: Hiển Thị Dưới Tile Map" />
                        <ComboBoxItem Content="Layer 2: Hiển Thị Dưới Player" />
                        <ComboBoxItem Content="Layer 3: Hiển Thị Trên Player" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-header" Text="Actions" />
                    <UniformGrid Columns="2" Margin="10,0,0,8">
                        <Button Name="LoadMapBtn" Width="120" Content="Load Map" Click="LoadMapBtn_OnClick" />
                        <Button Name="LoadEffectBtn" Width="120" Content="Load Effects" Click="LoadEffectBtn_OnClick" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="10,0,0,8">
                        <Button Name="LoadItemBgBtn" Width="120" Content="Load Items Bg"
                                Click="LoadItemBgBtn_OnClick" />
                        <Button Name="BuildDataBtn" Width="120" Content="Build Data" Click="BuildDataBtn_OnClick" />
                    </UniformGrid>
                    <Button Name="ClearMapBtn" Content="Clear Map" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Click="ClearMapBtn_OnClick" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>