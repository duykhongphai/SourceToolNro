<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <TrimMode>link</TrimMode>
        <ApplicationIcon>Assets/Icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.1"/>
        <PackageReference Include="Avalonia.Desktop" Version="11.2.1"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1"/>
        <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="MessageBox.Avalonia" Version="3.2.0"/>
        <PackageReference Include="MySqlConnector" Version="2.4.0"/>
        <PackageReference Include="SharpCompress" Version="0.39.0"/>
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.8"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\banner.png"/>
        <AvaloniaResource Include="Assets\banner.png"/>
        <None Remove="Assets\Icon.ico"/>
        <AvaloniaResource Include="Assets\Icon.ico"/>
        <None Remove="Assets\Fonts\SegoeUIBold.ttf"/>
        <AvaloniaResource Include="Assets\Fonts\SegoeUIBold.ttf"/>
        <None Remove="Assets\Fonts\SegoeUISemibold.ttf"/>
        <AvaloniaResource Include="Assets\Fonts\SegoeUISemibold.ttf"/>
        <None Remove="Assets\Resources\eraser.png"/>
        <AvaloniaResource Include="Assets\Resources\eraser.png"/>
        <None Remove="Assets\Resources\eraser24.png"/>
        <AvaloniaResource Include="Assets\Resources\eraser24.png"/>
        <None Remove="Assets\Resources\folder.png"/>
        <AvaloniaResource Include="Assets\Resources\folder.png"/>
        <None Remove="Assets\Resources\folderSelected.png"/>
        <AvaloniaResource Include="Assets\Resources\folderSelected.png"/>
        <None Remove="Assets\Resources\info.png"/>
        <AvaloniaResource Include="Assets\Resources\info.png"/>
        <None Remove="Assets\Resources\infoSelected.png"/>
        <AvaloniaResource Include="Assets\Resources\infoSelected.png"/>
        <None Remove="Assets\Resources\map.png"/>
        <AvaloniaResource Include="Assets\Resources\map.png"/>
        <None Remove="Assets\Resources\mapSelected.png"/>
        <AvaloniaResource Include="Assets\Resources\mapSelected.png"/>
        <None Remove="Assets\Resources\sql.png"/>
        <AvaloniaResource Include="Assets\Resources\sql.png"/>
        <None Remove="Assets\Resources\sqlSelected.png"/>
        <AvaloniaResource Include="Assets\Resources\sqlSelected.png"/>
        <None Remove="Assets\Resources\npc.png"/>
        <AvaloniaResource Include="Assets\Resources\npc.png"/>
        <None Remove="Assets\Resources\monster.png"/>
        <AvaloniaResource Include="Assets\Resources\monster.png"/>
        <None Remove="Assets\Resources\portal.png"/>
        <AvaloniaResource Include="Assets\Resources\portal.png"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Assets\Resources\"/>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="Avalonia.Themes.Fluent"/>
        <TrimmerRootAssembly Include="SixLabors.ImageSharp"/>
    </ItemGroup>
</Project>
