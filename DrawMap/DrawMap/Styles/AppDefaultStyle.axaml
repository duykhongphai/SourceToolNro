<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Background="AliceBlue" Width="300" Height="100">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="22" Width="100" Background="LightBlue">Block 1</TextBlock>
                    <TextBlock FontSize="22" Width="100">Block 2</TextBlock>
                    <TextBlock FontSize="22" Width="100" Background="LightBlue">Block 3</TextBlock>
                    <TextBlock FontSize="22" Width="100">Block 4</TextBlock>
                    <TextBlock FontSize="22" Width="100" Background="LightBlue">Block 5</TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource SegoeUISemibold}" />
    </Style>
    <Style Selector="Button.glass">
        <Setter Property="Background" Value="#4D8B7FC7" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
    </Style>

    <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#668B7FC7" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#80FFFFFF" />
    </Style>

    <Style Selector="Button.glass:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#338B7FC7" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#4DFFFFFF" />
    </Style>
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="#5A5570" />
        <Setter Property="Foreground" Value="#E2D8F7" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#6B6580" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#4A4560" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.purple">
        <Setter Property="Background" Value="{DynamicResource PurpleGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.purple:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PurpleGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.purple:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PurpleGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.aqua">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.aqua:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.aqua:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AquaGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.dark">
        <Setter Property="Background" Value="{DynamicResource DarkGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DarkGradientBrushHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.dark:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DarkGradientBrushPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#4361EE" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Width" Value="110" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A53D0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2E44B3" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#333" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Width" Value="110" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F8F8F8" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#EFEFEF" />
        <Setter Property="BorderBrush" Value="#A0A0A0" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#CDCDCD" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#505050" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="4,0,0,0" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#FF374151" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Width="14" Height="14"
                            Background="White"
                            BorderBrush="#FFD1D5DB"
                            BorderThickness="1.5"
                            CornerRadius="7"
                            Margin="0,0,6,0">
                        <Ellipse Name="RadioMark"
                                 Width="6" Height="6"
                                 Fill="#FF3B82F6"
                                 IsVisible="False" />
                    </Border>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton:checked /template/ Ellipse#RadioMark">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="RadioButton:checked /template/ Border">
        <Setter Property="BorderBrush" Value="#FF3B82F6" />
    </Style>

    <Style Selector="RadioButton:checked">
        <Setter Property="Foreground" Value="#FF1D4ED8" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="#667EEA" />
        <Setter Property="Background" Value="#FAFBFF" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="#667EEA" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{DynamicResource SegoeUIBold}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F0F0F0" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#E8E8E8" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#D8D8D8" />
    </Style>
</Styles>