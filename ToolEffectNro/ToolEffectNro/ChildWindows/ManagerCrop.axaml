    </Window.Resources>
    <Grid RowDefinitions="*,20,32" Background="#3A384D">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <WrapPanel Name="PanelImage"
                       Orientation="Horizontal"
                       HorizontalAlignment="Left"
                       Opacity="1"
                       Margin="20" />
        </ScrollViewer>
        <Separator Grid.Row="1" Background="White" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Name="Left" Click="Left_OnClick" Background="#3A384D" Margin="10,0,0,5">
                <PathIcon Height="24" Width="24" Foreground="White"
                          Data="{StaticResource caret_left_regular}" />
            </Button>
            <Button Name="Right" Click="Right_OnClick" Background="#3A384D" Margin="5,0,0,5">
                <PathIcon Height="24" Width="24" Foreground="White"
                          Data="{StaticResource caret_right_regular}" />
            </Button>
            <Button Name="Delete" Click="Delete_OnClick" Background="#3A384D" Margin="5,0,0,5">
                <PathIcon Height="24" Width="24" Foreground="White"
                          Data="{StaticResource delete_regular}" />
            </Button>
            <Button Name="Restore" Click="Restore_OnClick" Background="#3A384D" Margin="5,0,0,5">
                <PathIcon Height="24" Width="24" Foreground="White"
                          Data="{StaticResource arrow_sync_circle_regular}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>